VITE_ALLOW_MULTIPLE_ORGANIZATIONS=true
# Mirror of the backend MFA_ENABLED (shows two-factor setup in security settings)
VITE_MFA_ENABLED=false
# Marketing site (legal page links); defaults to BRAND.marketingOrigin
VITE_MARKETING_ORIGIN=
# The script is only added when this is set; e.g. http://localhost:3001/script.js
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
VITE_TAWK_KEY=
# Browser telemetry (Grafana Faro) - /collect is proxied to the Alloy agent; empty disables
VITE_FARO_URL=
