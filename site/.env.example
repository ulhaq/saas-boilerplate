# Design theme, picked at build time: editorial | tech | soft | swiss | brutal |
# enterprise | nordic | aurora (see src/themes/). Restart the dev server after changing.
SITE_THEME=editorial
# Canonical origin of this site (canonical/hreflang tags, OG image, sitemap)
SITE_URL=http://localhost:4321
# The signed-in app (frontend/); login and sign-up links point here
PUBLIC_APP_URL=http://localhost:5173
# Where the dev server proxies /v1 (contact form, waitlist); nginx does it in production
API_TARGET=http://localhost:8000
# `signup` links to the app's registration page; `waitlist` swaps every CTA for the waitlist form
PUBLIC_CTA_MODE=signup
# Footer link; empty hides it
PUBLIC_API_DOCS_URL=http://localhost:8000/redoc
# Cookieless analytics; the script is only added when both are set
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=
