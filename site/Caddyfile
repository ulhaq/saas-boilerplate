:80

root * /srv
encode gzip

header {
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' {$ANALYTICS_ORIGIN}; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' {$ANALYTICS_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

# Only the public endpoints the site's forms use; everything else on the
# API stays on api.example.com.
@apiForms path /v1/contact /v1/waitlist
handle @apiForms {
	@notPost not method POST
	respond @notPost 405

	request_body {
		max_size 32KB
	}

	reverse_proxy {$API_TARGET}
}

handle /_astro/* {
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}

handle {
	file_server
}

handle_errors {
	rewrite * /404.html
	file_server
}
