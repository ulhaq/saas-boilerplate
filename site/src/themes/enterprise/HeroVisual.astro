---
/** A product dashboard: sidebar, key figures and the project table. */
import { useSample } from '../../content/sample'
import type { Locale } from '../../i18n/routes'

interface Props {
  locale: Locale
}

const s = useSample(Astro.props.locale)
---

<div class="nv-app" aria-hidden="true">
  <div class="nv-top"><i></i><i></i><i></i></div>
  <div class="nv-body">
    <div class="nv-side">
      {s.nav.map((item, i) => <div class:list={{ 'nv-on': i === 0 }}>{item}</div>)}
    </div>
    <div class="nv-main">
      <div class="nv-kpis">
        {
          s.kpis.map((kpi) => (
            <div class="nv-kpi">
              <small>{kpi.label}</small>
              <b>{kpi.value}</b>
            </div>
          ))
        }
      </div>
      <div class="nv-table">
        <div class="nv-tr nv-th">
          <span>{s.columns.project}</span><span>{s.columns.owner}</span><span>{s.columns.status}</span>
        </div>
        {
          s.projects.slice(0, 3).map((project) => (
            <div class="nv-tr">
              <span>{project.name}</span>
              <span>{project.owner}</span>
              <span class:list={['nv-st', { 'nv-review': project.state === 'review' }]}>
                {project.status}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .nv-app {
    max-width: 1040px;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 14px 14px 0 0;
    background: #fff;
    box-shadow: 0 40px 80px -40px rgb(11 31 68 / 0.35);
    text-align: left;
    font-size: 0.9rem;
  }

  .nv-top {
    display: flex;
    gap: 6px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--rule);
    background: var(--surface-2);
  }

  .nv-top i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d3dae6;
  }

  .nv-body {
    display: grid;
  }

  .nv-side {
    display: none;
    padding: 16px;
    border-right: 1px solid var(--rule);
    color: var(--muted);
  }

  .nv-side div {
    padding: 8px 10px;
    border-radius: 6px;
  }

  .nv-side .nv-on {
    background: var(--accent-soft);
    color: var(--accent-text);
    font-weight: 600;
  }

  .nv-main {
    padding: 20px;
    min-width: 0;
  }

  .nv-kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
  }

  .nv-kpi {
    padding: 12px;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .nv-kpi small {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .nv-kpi b {
    display: block;
    font-size: 1.4rem;
    color: #0b1f44;
  }

  .nv-tr {
    display: grid;
    grid-template-columns: 1.6fr 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 10px 8px;
    border-bottom: 1px solid var(--rule);
  }

  .nv-th {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }

  .nv-st {
    padding: 2px 8px;
    border-radius: 999px;
    background: #e6f6f5;
    color: #0b7d7c;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .nv-st.nv-review {
    background: #fff4e5;
    color: #a45a00;
  }

  @media (min-width: 800px) {
    .nv-body {
      grid-template-columns: 190px 1fr;
    }
    .nv-side {
      display: block;
    }
  }
</style>
