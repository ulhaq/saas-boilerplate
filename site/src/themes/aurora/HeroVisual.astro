---
/** A frosted app window with project progress bars. */
import { useSample } from '../../content/sample'
import type { Locale } from '../../i18n/routes'

interface Props {
  locale: Locale
}

const s = useSample(Astro.props.locale)
const dots = ['#8b5cf6', '#22d3ee', '#f472b6', '#a3e635']
---

<div class="av-window" aria-hidden="true">
  <div class="av-inner">
    <div class="av-side">
      {s.nav.map((item, i) => <div class:list={{ 'av-on': i === 0 }}>{item}</div>)}
    </div>
    <div class="av-main">
      {
        s.projects.map((project, i) => (
          <div class="av-row">
            <span class="av-dot" style={`background:${dots[i % dots.length]}`} />
            {project.name}
            <span class="av-prog">
              <b style={`width:${project.progress}%`} />
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .av-window {
    max-width: 980px;
    margin-inline: auto;
    padding: 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 20px;
    background: var(--surface);
    backdrop-filter: blur(18px);
    box-shadow: 0 40px 120px -40px rgb(139 92 246 / 0.6);
    text-align: left;
  }

  .av-inner {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: rgb(10 9 28 / 0.75);
  }

  .av-side {
    display: none;
    padding: 16px;
    border-right: 1px solid var(--rule);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .av-side div {
    padding: 7px 10px;
    border-radius: 8px;
  }

  .av-side .av-on {
    background: rgb(139 92 246 / 0.25);
    color: var(--ink);
  }

  .av-main {
    display: grid;
    gap: 12px;
    padding: 20px;
  }

  .av-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.04);
    font-size: 0.95rem;
  }

  .av-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .av-prog {
    flex: none;
    margin-left: auto;
    width: 110px;
    height: 6px;
    overflow: hidden;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.08);
  }

  .av-prog b {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, #8b5cf6, #22d3ee);
  }

  @media (min-width: 800px) {
    .av-inner {
      grid-template-columns: 180px 1fr;
    }
    .av-side {
      display: block;
    }
  }
</style>
