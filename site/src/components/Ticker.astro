---
/** The highlight items as a scrolling strip above the header (`highlights: 'ticker'`). */
import type { Locale } from '../i18n/routes'
import { useMessages } from '../i18n/ui'

interface Props {
  locale: Locale
}

const t = useMessages(Astro.props.locale)
const line = t.highlights.map((item) => item.value).join(' · ')
---

<div class="ticker" aria-label={t.highlights.map((item) => item.value).join(', ')}>
  <span aria-hidden="true">★ {line} ★ {line} ★ {line} ★</span>
</div>
