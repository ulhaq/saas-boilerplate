---
/**
 * The plans. One markup for every theme: cards by default, ledger rows in
 * the editorial theme. Each plan lists its limits (`plan-stats`) and the
 * features that set it apart from cheaper plans (`plan-features`). The price is
 * rendered in every currency and billing period - the locale's currency, monthly,
 * shown; two switches (with JavaScript only) show another, remembered in the
 * browser and handed to the app's links.
 */
import { CTA_MODE, appUrl } from '../config'
import {
  COMPARISON,
  CURRENCIES,
  CURRENCY,
  INTERVALS,
  PLANS,
  RECOMMENDED_PLAN,
  TRIAL_DAYS,
  formatPrice,
  planAmount,
  yearlySaving,
} from '../content/plans'
import { path, type Locale } from '../i18n/routes'
import { fmt, useMessages } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useMessages(locale)
const rows = COMPARISON[locale]
const stats = rows.filter((row) => row.stat)
// Features some plan lacks - "API tokens" - rather than ones every plan has.
const extras = rows.filter(
  (row) => !row.stat && PLANS.some((plan) => row.values[plan.name] === false),
)
const ctaHref = CTA_MODE === 'waitlist' ? `${path('home', locale)}#waitlist` : appUrl('/register')
---

<div class="plans-switches" data-plans-switches hidden>
  <div class="plans-switch plans-switch--interval" role="radiogroup" aria-label={t.pricing.interval}>
    {
      INTERVALS.map((interval) => (
        <button
          type="button"
          role="radio"
          data-interval={interval}
          aria-checked={interval === 'month' ? 'true' : 'false'}
        >
          {t.pricing.intervals[interval]}
          {interval === 'year' &&
            CURRENCIES.map((currency) => {
              const saving = yearlySaving(currency)
              return saving ? (
                <span
                  class="plans-switch-saving"
                  data-saving-currency={currency}
                  hidden={currency !== CURRENCY[locale]}
                >
                  {'months' in saving
                    ? fmt(saving.months === 1 ? t.pricing.oneMonthFree : t.pricing.monthsFree, {
                        count: saving.months,
                      })
                    : fmt(t.pricing.yearlySaving, saving)}
                </span>
              ) : null
            })}
        </button>
      ))
    }
  </div>
  <div class="plans-switch plans-switch--currency" role="radiogroup" aria-label={t.pricing.currency}>
    {
      CURRENCIES.map((currency) => (
        <button
          type="button"
          role="radio"
          data-currency={currency}
          aria-checked={currency === CURRENCY[locale] ? 'true' : 'false'}
        >
          {currency}
        </button>
      ))
    }
  </div>
</div>

<ol class="plans">
  {
    PLANS.map((plan) => {
      const free = planAmount(plan, locale) === 0
      const recommended = plan.name === RECOMMENDED_PLAN
      const included = extras.filter((row) => row.values[plan.name] === true)
      return (
        <li class:list={['plan', { 'is-recommended': recommended, 'is-free': free }]}>
          <div class="plan-head">
            {recommended && <span class="plan-badge">{t.pricing.recommended}</span>}
            <h3 class="plan-name">{plan.name}</h3>
            <p class="plan-desc">{plan.description[locale]}</p>
          </div>
          <dl class="plan-stats">
            {stats.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd>{row.values[plan.name]}</dd>
              </div>
            ))}
          </dl>
          <div class="plan-prices">
            {CURRENCIES.flatMap((currency) =>
              // The free plan has one price, whatever the period.
              (free ? (['month'] as const) : INTERVALS).map((interval) => {
                // A yearly price is shown by the month too (it is twelve whole months' worth,
                // `plans.ts`), its yearly total under it, so the periods compare at a glance.
                const total = planAmount(plan, locale, currency, interval)
                const yearly = interval === 'year'
                return (
                  <div
                    class="plan-price"
                    data-price-currency={currency}
                    data-price-interval={free ? undefined : interval}
                    hidden={currency !== CURRENCY[locale] || interval !== 'month'}
                  >
                    <span class="plan-amount">
                      {formatPrice(yearly ? Math.round(total / 12) : total, locale, currency)}
                    </span>
                    <span class="plan-per">
                      {free ? t.pricing.free : `${t.pricing.perMonth}, ${t.pricing.exclVat}`}
                    </span>
                    {yearly && (
                      <span class="plan-per">
                        {fmt(t.pricing.billedYearly, {
                          price: formatPrice(total, locale, currency),
                        })}
                      </span>
                    )}
                  </div>
                )
              }),
            )}
          </div>
          {included.length > 0 && (
            <ul class="plan-features">
              {included.map((row) => (
                <li>{row.label}</li>
              ))}
            </ul>
          )}
          <a class:list={['btn', recommended ? '' : 'btn--ghost']} href={ctaHref}>
            {CTA_MODE === 'waitlist'
              ? t.nav.waitlist
              : free || !TRIAL_DAYS
                ? t.cta.free
                : fmt(t.cta.trial, { days: TRIAL_DAYS })}
            <span class="visually-hidden">({plan.name})</span>
          </a>
        </li>
      )
    })
  }
</ol>

<script>
  import { saveCurrency, saveInterval, savedCurrency, savedInterval } from '../scripts/currency'

  // Every plans list on the page follows one currency and one billing period, kept
  // for the next visit and passed to the app by its links (`scripts/currency.ts`).
  const switches = [...document.querySelectorAll<HTMLElement>('[data-plans-switches]')]
  const currencyOptions = switches.flatMap((el) => [
    ...el.querySelectorAll<HTMLButtonElement>('[data-currency]'),
  ])
  const intervalOptions = switches.flatMap((el) => [
    ...el.querySelectorAll<HTMLButtonElement>('[data-interval]'),
  ])
  const offeredCurrencies = new Set(currencyOptions.map((option) => option.dataset.currency))
  const offeredIntervals = new Set(intervalOptions.map((option) => option.dataset.interval))

  const shown = {
    currency: currencyOptions.find((o) => o.getAttribute('aria-checked') === 'true')?.dataset
      .currency,
    interval: 'month',
  }

  function render() {
    currencyOptions.forEach((option) =>
      option.setAttribute('aria-checked', String(option.dataset.currency === shown.currency)),
    )
    intervalOptions.forEach((option) =>
      option.setAttribute('aria-checked', String(option.dataset.interval === shown.interval)),
    )
    document.querySelectorAll<HTMLElement>('[data-saving-currency]').forEach((saving) => {
      saving.hidden = saving.dataset.savingCurrency !== shown.currency
    })
    document.querySelectorAll<HTMLElement>('[data-price-currency]').forEach((price) => {
      // A price without a period (the free plan's) shows in every period.
      const interval = price.dataset.priceInterval
      price.hidden =
        price.dataset.priceCurrency !== shown.currency ||
        (interval !== undefined && interval !== shown.interval)
    })
  }

  const currency = savedCurrency()
  if (currency && offeredCurrencies.has(currency)) shown.currency = currency
  const interval = savedInterval()
  if (interval && offeredIntervals.has(interval)) shown.interval = interval
  render()

  switches.forEach((el) => (el.hidden = false))
  currencyOptions.forEach((option) =>
    option.addEventListener('click', () => {
      shown.currency = option.dataset.currency!
      render()
      saveCurrency(shown.currency)
    }),
  )
  intervalOptions.forEach((option) =>
    option.addEventListener('click', () => {
      shown.interval = option.dataset.interval!
      render()
      saveInterval(shown.interval)
    }),
  )
</script>
