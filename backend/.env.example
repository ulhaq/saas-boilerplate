# App
APP_NAME=SaaS Boilerplate
APP_URL=http://localhost:8000
APP_ENV=local
APP_SECRET=
APP_DEBUG=true

# Organizations
ALLOW_MULTIPLE_ORGANIZATIONS=true

# Frontend proxy target (inside Docker network)
API_TARGET=http://backend:8000

# Database connection (inside Docker network)
DB_CONNECTION=

# Postgres superuser password
POSTGRES_PASSWORD=

# Scoped DB users (created automatically on first container start via postgres/init.sh)
DB_NAME=
DB_USER=
DB_PASSWORD=

# Umami analytics
UMAMI_APP_SECRET=
DB_UMAMI_USER=
DB_UMAMI_PASSWORD=

# PgAdmin (local profile only)
PGADMIN_EMAIL=admin@example.org
PGADMIN_PASSWORD=password

# Docker build (Dockerfile.dev for local, Dockerfile for prod)
DOCKERFILE=Dockerfile.dev
FRONTEND_DOCKERFILE=Dockerfile.dev

# Auth
AUTH_ENABLED=true
RATE_LIMIT_ENABLED=true

# CORS
ALLOW_ORIGINS=http://localhost:5173
ALLOW_CREDENTIALS=true

# Email
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TLS=false
EMAIL_FROM_ADDRESS=info@example.org
EMAIL_FROM_NAME="SaaS Boilerplate"

# Frontend
FRONTEND_URL=http://localhost:5173

# Example product (src/example/config.py)
EXAMPLE_HEARTBEAT_INTERVAL_SECONDS=3600

# Logging
LOG_FORMAT=text
SQLALCHEMY_ECHO=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL="http://localhost:5173/billing/success"
BILLING_CANCEL_URL="http://localhost:5173/billing/cancel"
BILLING_PORTAL_RETURN_URL="http://localhost:5173/settings/billing"
BILLING_AUTOMATIC_TAX=true
BILLING_TRIAL_PERIOD_DAYS=7
BILLING_TRIAL_REMINDER_DELAY_DAYS=3
BILLING_TRIAL_REMINDER_INTERVAL_SECONDS=86400