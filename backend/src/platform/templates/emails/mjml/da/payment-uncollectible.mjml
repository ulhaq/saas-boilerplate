<mjml>
  <mj-head>
    <mj-title>Abonnement nedgraderet - {{ app_name }}</mj-title>
    <mj-preview>Vi kunne ikke opkræve betaling, så din {{ app_name }}-konto blev nedgraderet.</mj-preview>
    <mj-include path="../shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#dc2828" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            Abonnement nedgraderet
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            Din konto er nedgraderet til gratis-planen
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Hej {{ user_name }},
          </mj-text>
          <mj-text padding="0 0 20px 0">
            Efter flere forsøg kunne vi ikke opkræve betaling for dit {{ app_name }}-abonnement, så din konto er flyttet til gratis-planen.
          </mj-text>

          <mj-text padding="0 0 24px 0">
            <div style="background:#fef2f2;border:1px solid #fecaca;border-left:3px solid #dc2828;border-radius:8px;padding:14px 16px;font-size:14px;color:#991b1b;line-height:1.6;">
              Dine data er bevaret, men betalte funktioner er sat på pause. Opdatér din betalingsmetode og tegn abonnement igen for at få fuld adgang.
            </div>
          </mj-text>

          <mj-button href="{{ billing_url }}" align="left">
            Opdatér fakturering &amp; tegn abonnement igen
          </mj-button>

          <mj-text padding="24px 0 0 0" color="#636b7e" font-size="14px">
            Hvis du mener, dette er en fejl, så bare svar på denne email.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="./partials/_footer.mjml" />
  </mj-body>
</mjml>
