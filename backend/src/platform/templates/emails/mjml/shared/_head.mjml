<mj-attributes>
  <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
  <mj-text font-size="15px" color="#3d465c" line-height="1.65" />
  <mj-button background-color="#293e70" color="#f8fafc" border-radius="8px" font-size="15px" font-weight="600" inner-padding="13px 28px" />
  <mj-section padding="0" />
</mj-attributes>
<mj-style inline="inline">
  a { text-decoration: none; }
</mj-style>
<mj-style>
  .app-card { box-shadow: 0 1px 2px rgba(18,23,33,0.06); }
  @media only screen and (max-width:480px) {
    .app-pad > div { padding-left: 24px !important; padding-right: 24px !important; }
  }
</mj-style>
