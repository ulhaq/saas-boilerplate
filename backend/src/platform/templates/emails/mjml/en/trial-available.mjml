<mjml>
  <mj-head>
    <mj-title>Your free trial is waiting - {{ app_name }}</mj-title>
    <mj-preview>You still have {{ trial_days }} days of {{ app_name }} free - start whenever you're ready.</mj-preview>
    <mj-include path="../shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#25934d" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            Free trial available
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            Your {{ trial_days }}-day free trial is still waiting
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Hi {{ user_name }},
          </mj-text>
          <mj-text padding="0 0 20px 0">
            You haven't started your free trial yet - it's still available on your account. Start it today and get {{ trial_days }} days of full access to {{ app_name }}.
          </mj-text>

          <mj-button href="{{ billing_url }}" align="left">
            Start my free trial
          </mj-button>

          <mj-text padding="24px 0 0 0" color="#636b7e" font-size="14px">
            Not sure if {{ app_name }} is right for you? Just reply to this email - we're happy to help.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="./partials/_footer.mjml" />
  </mj-body>
</mjml>
