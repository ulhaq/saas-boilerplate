<mjml>
  <mj-head>
    <mj-title>Your trial has ended - {{ app_name }}</mj-title>
    <mj-preview>Your {{ app_name }} trial has ended. Upgrade to restore full access.</mj-preview>
    <mj-include path="../shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#636b7e" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            Trial ended
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            Your trial has ended
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Hi {{ user_name }},
          </mj-text>
          <mj-text padding="0 0 20px 0">
            Your free trial of {{ app_name }} has ended and your account has moved to the free plan. Upgrade any time to get paid features back.
          </mj-text>

          <mj-text padding="0 0 24px 0">
            <div style="background:#f8fafc;border:1px solid #e0e3eb;border-left:3px solid #989fae;border-radius:8px;padding:14px 16px;font-size:14px;color:#3d465c;line-height:1.6;">
              Your data is safe - nothing is deleted. Upgrade to get paid features back.
            </div>
          </mj-text>

          <mj-button href="{{ billing_url }}" align="left">
            Upgrade now
          </mj-button>

          <mj-text padding="24px 0 0 0" color="#636b7e" font-size="14px">
            Questions about upgrading? Just reply to this email.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="./partials/_footer.mjml" />
  </mj-body>
</mjml>
