<mjml>
  <mj-head>
    <mj-title>Account deleted - {{ app_name }}</mj-title>
    <mj-preview>Your account has been deleted.</mj-preview>
    <mj-include path="../shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#dc2828" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            Account deleted
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            Your account has been deleted
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Hi {{ user_name }},
          </mj-text>
          <mj-text padding="0 0 20px 0">
            Your {{ app_name }} account has been deleted and you can no longer sign in.
          </mj-text>

          <mj-text padding="0 0 20px 0">
            <div style="background:#fef2f2;border:1px solid #fecaca;border-left:3px solid #dc2828;border-radius:8px;padding:14px 16px;font-size:14px;color:#991b1b;line-height:1.6;">
              Your data will be permanently purged after <strong>{{ retention_days }} days</strong>, in line with our data retention policy.
            </div>
          </mj-text>

          <mj-text padding="0 0 0 0" color="#636b7e" font-size="14px">
            If you didn't request this, please contact our support team immediately at <a href="mailto:{{ info_email }}" style="color:#293e70;font-weight:500;">{{ info_email }}</a>.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="./partials/_footer.mjml" />
  </mj-body>
</mjml>
