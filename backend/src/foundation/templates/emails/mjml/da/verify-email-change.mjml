<mjml>
  <mj-head>
    <mj-title>Bekræft din nye email - {{ app_name }}</mj-title>
    <mj-preview>Bekræft din nye emailadresse til {{ app_name }}.</mj-preview>
    <mj-include path="../shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#636b7e" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            Ændring af email
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            Bekræft din nye emailadresse
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Hej {{ user_name }},
          </mj-text>
          <mj-text padding="0 0 24px 0">
            Du har bedt om at ændre emailen på din {{ app_name }}-konto til <strong>{{ new_email }}</strong>. Bekræft for at fuldføre - linket udløber om {{ expiration_hours }}&nbsp;time{% if expiration_hours != 1 %}r{% endif %}. Når du har bekræftet, bliver du logget ud og kan logge ind med den nye adresse.
          </mj-text>

          <mj-button href="{{ confirm_url }}" align="left">
            Bekræft ny email
          </mj-button>

          <mj-text padding="24px 0 0 0" color="#636b7e" font-size="14px">
            Har du ikke bedt om dette? Ignorer denne email - din emailadresse ændres ikke.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="./partials/_footer.mjml" />
  </mj-body>
</mjml>
