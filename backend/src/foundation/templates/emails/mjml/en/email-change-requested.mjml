<mjml>
  <mj-head>
    <mj-title>Email change requested - {{ app_name }}</mj-title>
    <mj-preview>Someone asked to change the email on your {{ app_name }} account.</mj-preview>
    <mj-include path="../shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#636b7e" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            Security notice
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            Email change requested
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Hi {{ user_name }},
          </mj-text>
          <mj-text padding="0 0 24px 0">
            A request was made to change the email on your {{ app_name }} account from this address to <strong>{{ new_email }}</strong>. Nothing changes until the new address is confirmed.
          </mj-text>

          <mj-button href="{{ reset_url }}" align="left">
            Secure my account
          </mj-button>

          <mj-text padding="24px 0 0 0" color="#636b7e" font-size="14px">
            If this was you, no action is needed. If it wasn't, reset your password right away - the change needed your password and two-factor code.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="./partials/_footer.mjml" />
  </mj-body>
</mjml>
