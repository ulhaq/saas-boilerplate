<mjml>
  <mj-head>
    <mj-title>New project - {{ app_name }}</mj-title>
    <mj-preview>{{ creator_name }} created {{ project_name }}</mj-preview>
    <mj-include path="../../../../../foundation/templates/emails/mjml/shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../../../../../foundation/templates/emails/mjml/shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#636b7e" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            New project
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            {{ project_name }}
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Hi {{ user_name }},
          </mj-text>
          <mj-text padding="0 0 24px 0">
            {{ creator_name }} created the project {{ project_name }} in {{ app_name }}.
          </mj-text>

          <mj-button href="{{ projects_url }}" align="left">
            View projects
          </mj-button>

          <mj-text padding="24px 0 0 0" color="#636b7e" font-size="14px">
            You can turn these emails off under Settings → Notifications.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="../../../../../foundation/templates/emails/mjml/en/partials/_footer.mjml" />
  </mj-body>
</mjml>
