<mjml>
  <mj-head>
    <mj-title>Duplicate subscription refunded - {{ app_name }}</mj-title>
    <mj-preview>We canceled a second {{ app_name }} subscription and refunded it in full.</mj-preview>
    <mj-include path="../../../../../foundation/templates/emails/mjml/shared/_head.mjml" />
  </mj-head>
  <mj-body background-color="#eff1f5" width="600px">
    <mj-wrapper background-color="#ffffff" border="1px solid #e0e3eb" border-radius="12px" padding="0" css-class="app-card">
      <mj-include path="../../../../../foundation/templates/emails/mjml/shared/_header.mjml" />

      <mj-section padding="28px 32px 32px 32px" css-class="app-pad">
        <mj-column>
          <mj-text font-size="13px" font-weight="600" color="#25934d" text-transform="uppercase" letter-spacing="0.04em" padding="0 0 10px 0">
            Refund issued
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#131825" line-height="1.3" padding="0 0 14px 0">
            We refunded a duplicate subscription
          </mj-text>

          <mj-text padding="0 0 8px 0">
            Hi {{ user_name }},
          </mj-text>
          <mj-text padding="0 0 8px 0">
            Your organization was charged for a second {{ app_name }} subscription - most likely the checkout was completed twice. We've canceled the duplicate and refunded its payment in full. Your original subscription is unchanged.
          </mj-text>
          <mj-text padding="0 0 24px 0" color="#636b7e" font-size="14px">
            Refunds usually take 5-10 business days to appear on your statement.
          </mj-text>

          <mj-button href="{{ billing_url }}" align="left">
            View billing
          </mj-button>

          <mj-text padding="24px 0 0 0" color="#636b7e" font-size="14px">
            Questions? Just reply to this email.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="../../../../../foundation/templates/emails/mjml/en/partials/_footer.mjml" />
  </mj-body>
</mjml>
