FROM python:3.15-slim

WORKDIR /app

RUN pip install uv

# Dev tools (locust → brotli) have no Python 3.15 wheels and the slim image has no
# compiler, so every `uv run` in the container skips the dev group.
ENV UV_NO_DEV=1

COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev

EXPOSE 8000

CMD ["uv", "run", "fastapi", "dev", "src/main.py", "--host", "0.0.0.0", "--port", "8000"]
