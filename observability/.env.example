# Monitoring host settings for docker-compose.observability.yml:
#   cp observability/.env.example observability/.env
#   docker compose -f docker-compose.observability.yml -p observability --env-file observability/.env up -d
# Every value has a local-dev default; set these in production.

# Grafana login - change the password before exposing Grafana anywhere
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Public URL (used in alert email links); Grafana listens on GRAFANA_BIND:GRAFANA_PORT
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3030

# Alerts are emailed here via SMTP
ALERT_EMAIL=ops@example.com
GRAFANA_SMTP_HOST=smtp.example.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=alerts@example.com
GRAFANA_SMTP_SKIP_VERIFY=false

# Interface for the ingest ports (Prometheus 9090, Loki 3100, Tempo 4318). They
# accept unauthenticated writes: use the private network address the app host
# reaches this server on, and firewall them to the app host.
OBSERVABILITY_INGEST_BIND=10.0.0.3

# Retention
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=168h
TEMPO_RETENTION=168h
